{
  "entities": {
    "products": {
      "title": "Products",
      "description": "Catalog of tech products available in the store",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "category": { "type": "string" },
        "brand": { "type": "string" },
        "image": { "type": "string" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "stock": { "type": "number" },
        "isDeal": { "type": "boolean" },
        "isNew": { "type": "boolean" },
        "specs": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["name", "price", "category", "stock"]
    },
    "orders": {
      "title": "Orders",
      "description": "Store customer orders and invoices",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "totalAmount": { "type": "number" },
        "subtotal": { "type": "number" },
        "tax": { "type": "number" },
        "status": { "type": "string" },
        "trackingCode": { "type": "string" },
        "items": { "type": "array" },
        "shippingAddress": { "type": "object" },
        "billingInfo": { "type": "object" },
        "paymentMethod": { "type": "object" }
      },
      "required": ["totalAmount", "status", "items"]
    },
    "customers": {
      "title": "Customers",
      "description": "Registered store customers in TecnoPlace e-commerce",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "cedulaOrRuc": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "password": { "type": "string" },
        "createdAt": { "type": "string" },
        "status": { "type": "string" },
        "totalOrders": { "type": "number" }
      },
      "required": ["name", "email"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "products",
      "description": "Catalog of products"
    },
    "/orders/{orderId}": {
      "schema": "orders",
      "description": "Store orders and invoices"
    },
    "/customers/{customerId}": {
      "schema": "customers",
      "description": "Registered customer records"
    }
  }
}
